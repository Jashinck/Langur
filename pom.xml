<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <groupId>org.skylark.langur</groupId>
    <artifactId>langur</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Langur Agent Framework</name>
    <description>叶猴 - 通用Agent能力框架，支持ReAct、工具调用、多步规划与多Agent协作</description>

    <modules>
        <module>langur-common</module>
        <module>langur-domain</module>
        <module>langur-application</module>
        <module>langur-api</module>
        <module>langur-infrastructure</module>
        <module>langur-start</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <opentelemetry.version>1.61.0</opentelemetry.version>
        <archunit.version>1.2.1</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- H11 依赖治理：ArchUnit 架构守卫（守护 domain 纯度 / 分层无环 / common 无状态 Bean） -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.skylark.langur</groupId>
                <artifactId>langur-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.skylark.langur</groupId>
                <artifactId>langur-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.skylark.langur</groupId>
                <artifactId>langur-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.skylark.langur</groupId>
                <artifactId>langur-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.skylark.langur</groupId>
                <artifactId>langur-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>17</source>
                        <target>17</target>
                        <!-- H11：release 固定 JDK 17（校验 bootclasspath，非 17 工具链即报错） -->
                        <release>17</release>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
