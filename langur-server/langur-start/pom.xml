<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.skylark.langur</groupId>
        <artifactId>langur</artifactId>
        <version>1.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>langur-start</artifactId>
    <name>Langur Start</name>

    <dependencies>
        <dependency>
            <groupId>org.skylark.langur</groupId>
            <artifactId>langur-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.skylark.langur</groupId>
            <artifactId>langur-infrastructure</artifactId>
        </dependency>
        <!-- jar 化 P2：start 装配点直接依赖 llm 适配器 jar（ModelProviderConfiguration） -->
        <dependency>
            <groupId>org.skylark.langur</groupId>
            <artifactId>langur-llm</artifactId>
        </dependency>
        <!-- jar 化 P4：start 装配点直接依赖 observability 适配器 jar（ObservabilityConfiguration + 组件扫描） -->
        <dependency>
            <groupId>org.skylark.langur</groupId>
            <artifactId>langur-observability</artifactId>
        </dependency>
        <!-- jar 化 P4：start 装配点直接依赖 security 适配器 jar（审批/注入守卫/内容审查 Bean 组件扫描） -->
        <dependency>
            <groupId>org.skylark.langur</groupId>
            <artifactId>langur-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
        </dependency>
        <!-- H5：Prometheus 指标导出（/actuator/prometheus）+ 健康检查 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- H14.7：pgvector 独立数据源驱动（store=pgvector 时装配 vectorJdbcTemplate） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- H11 依赖治理：ArchUnit 架构守卫 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>langur</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
